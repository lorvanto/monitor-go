# Only source, locked dependencies and documentation enter the build context.
**
!Dockerfile
!compose.yaml
!.dockerignore
!go.mod
!go.sum
!Makefile
!LICENSE
!NOTICE
!/*.md
!cmd/
!cmd/**
!internal/
!internal/**
!locales/
!locales/**
!web/
!web/**
!scripts/
!scripts/**
!docs/
!docs/**
!.github/
!.github/**
!third_party/
!third_party/**
!deploy/
!deploy/**

# These remain excluded even if created below an allowed source directory.
**/node_modules/
**/dist/
**/.git/
**/.DS_Store
**/.env
**/.env.*
**/config.local.*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/setup-token
**/enrollment-token
**/*.log
